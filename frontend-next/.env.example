# Hiver frontend (Next.js BFF). No secrets here — GROQ_API_KEY lives ONLY in the FastAPI backend env.
FASTAPI_URL=http://127.0.0.1:8000
# Optional: when the backend sets HIVER_API_KEY, set the SAME value here so the
# BFF forwards it as X-API-Key on every upstream call (browser never sees it).
# Leave unset for the default open loopback demo.
# HIVER_API_KEY=
